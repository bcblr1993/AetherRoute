            <title>Version 1.0.1 (Build 2026091302)</title>
            <pubDate>Sun, 13 Sep 2026 16:50:56 +0800</pubDate>
            <sparkle:version>2026091302</sparkle:version>
            <sparkle:shortVersionString>1.0.1</sparkle:shortVersionString>
