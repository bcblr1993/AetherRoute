  }
  code {
    font-size: 11px;
    padding: 1px 4px;
    border-radius: 3px;
    background: rgba(127, 127, 127, 0.12);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, monospace;
  }
  .footer-bar {
    margin-top: 14px;
    padding-top: 10px;
    border-top: 1px solid var(--border-color);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 11px;
    color: var(--text-muted);
  }
