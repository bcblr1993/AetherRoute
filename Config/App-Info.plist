	<string>AetherRoute accesses the local network only when you route traffic to a proxy, DNS server, or destination on your local network.</string>
	<key>NSSystemExtensionUsageDescription</key>
	<string>AetherRoute installs signed network extensions to provide transparent proxy and TUN routing.</string>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>AetherRoute Portable Profile Archive</string>
			<key>UTTypeIdentifier</key>
			<string>$(AETHERROUTE_PROFILE_ARCHIVE_TYPE)</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>aetherroute</string>
				</array>
				<key>public.mime-type</key>
				<string>application/vnd.aetherroute.profile-archive</string>
			</dict>
		</dict>
	</array>
