			<string>$(AETHERROUTE_SUBSCRIPTION_URL_NAME)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>aetherroute</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
