<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AetherRouteAppGroup</key>
	<string>$(AETHERROUTE_APP_GROUP)</string>
	<key>AetherRouteAuthorName</key>
	<string>陈艳男</string>
	<key>AetherRouteAuthorRomanizedName</key>
	<string>ChenYanNan</string>
	<key>AetherRouteDistributionProductIdentifier</key>
	<string>$(AETHERROUTE_DISTRIBUTION_PRODUCT_ID)</string>
	<key>AetherRouteDistributionMode</key>
	<string>$(AETHERROUTE_DISTRIBUTION_MODE)</string>
	<key>AetherRouteDistributionSigningPublicKey</key>
	<string>$(AETHERROUTE_DISTRIBUTION_PUBLIC_KEY)</string>
	<key>AetherRouteKeychainAccessGroup</key>
	<string>$(AppIdentifierPrefix)$(AETHERROUTE_KEYCHAIN_GROUP_SUFFIX)</string>
	<key>AetherRouteKeychainAccessGroupSuffix</key>
	<string>$(AETHERROUTE_KEYCHAIN_GROUP_SUFFIX)</string>
	<key>AetherRouteLicenseServiceURL</key>
	<string>$(AETHERROUTE_LICENSE_SERVICE_URL)</string>
	<key>AetherRouteProfileArchiveTypeIdentifier</key>
