          "stringUnit": {
            "state": "translated",
            "value": "新网络引擎无法连接，已自动恢复原引擎。"
          }
        }
      }
    },
    "The password is incorrect or the portable archive was modified.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密码不正确，或便携档案已被修改。"
