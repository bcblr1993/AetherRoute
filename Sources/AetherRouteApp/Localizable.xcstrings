    "The selected key is read into memory, never displayed, and saved only in the encrypted profile library.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选私钥仅载入内存且不会明文显示，只保存在加密配置库中。"
          }
        }
      }
    },
    "Choose a subscription update interval between 15 minutes and 7 days.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择 15 分钟到 7 天之间的订阅更新间隔。"
          }
        }
      }
    },
    "Enter a valid HTTPS subscription address without embedded credentials or a fragment.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入有效的 HTTPS 订阅地址，地址中不能包含内嵌凭据或片段。"
          }
        }
      }
    },
    "No proxies or proxy providers were found in the profile.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置中没有找到节点或节点提供方。"
          }
        }
      }
    },
    "Subscription node %lld is invalid.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅中的第 %lld 个节点无效。"
          }
        }
      }
    },
    "The executable profile key ‘%@’ is not allowed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不允许使用可执行配置键“%@”。"
