    "TUN applies IPv4 and IPv6 CIDR exclusions at the system route layer. Domain rules stay encrypted and apply when Transparent Proxy is selected.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TUN 会在系统路由层应用 IPv4 和 IPv6 CIDR 排除。域名规则保持加密，并在选择透明代理时生效。"
          }
        }
      }
    },
    "TUN runtime overrides": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TUN 运行时覆盖"
          }
        }
      }
    },
    "Test latency": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试延迟"
          }
        }
      }
    },
    "Testing latency…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在测试延迟…"
          }
        }
      }
    },
    "The activation key is sent only to your configured HTTPS license service and is never saved, logged, exported, or included in diagnostics. Receipts stay in the Data Protection Keychain on this Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "激活码只会发送到你配置的 HTTPS 授权服务，绝不会被保存、记录、导出或写入诊断报告。签名回执保存在这台 Mac 的数据保护钥匙串中。"
          }
        }
      }
    },
    "The active profile contains no ordered rule entries. Its effective fallback is determined only after the protocol core validates and starts the profile.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前配置没有有序规则。协议核心验证并启动配置后，才能确定实际的兜底行为。"
          }
        }
      }
    },
    "The active profile has no DNS section. The core therefore uses the system resolver behavior available to the selected network engine.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前配置没有 DNS 设置，因此核心会使用所选网络引擎可用的系统解析行为。"
          }
        }
      }
    },
    "The active profile is not a subscription.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前配置不是订阅配置。"
          }
        }
      }
    },
    "The active profile passed import checks but does not expose inline endpoints, groups, or providers.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前配置已通过导入检查，但没有提供内联节点、策略组或提供方。"
          }
        }
      }
    },
    "The address is stored inside the encrypted profile. Downloads are size-limited and validated before activation.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅地址会保存在加密配置中。下载内容经过大小限制和安全验证后才会启用。"
          }
        }
      }
    },
    "The download is size-limited and validated, then kept only for this preview session. It cannot enable system routing.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载内容会经过大小限制和安全验证，并且仅在本次预览会话中保留；它不能启用系统路由。"
          }
        }
      }
    },
    "The archive password is too long.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "档案密码过长。"
          }
        }
      }
    },
    "The bundled notice file could not be verified. Reinstall AetherRoute before distribution.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证内置许可声明文件。发布前请重新安装 AetherRoute。"
          }
        }
      }
    },
    "The connection could not continue. Open AetherRoute to review the recovery steps.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接无法继续。请打开 AetherRoute 查看恢复步骤。"
          }
        }
      }
    },
    "The connection is busy or not ready.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接正忙或尚未就绪。"
          }
        }
      }
    },
    "The current build number is invalid.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前构建号无效。"
          }
        }
      }
    },
    "The current core bridge reports lifecycle readiness only. Per-flow destinations, matched rules, and byte counters are not exposed by this build.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前核心桥接仅报告生命周期就绪状态；此版本尚未提供单个连接的目标、命中规则和字节计数。"
          }
        }
      }
    },
    "The diagnostic report could not be created.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法创建诊断报告。"
          }
        }
      }
    },
    "The diagnostic report could not be saved.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存诊断报告。"
          }
        }
      }
    },
    "The downloaded update failed its integrity check.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载的更新未通过完整性校验。"
          }
        }
      }
    },
    "The downloaded update is not a valid file.": {
      "localizations": {
        "zh-Hans": {
