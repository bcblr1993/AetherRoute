      }
    },
    "%@ (process name)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（进程名）"
          }
        }
      }
    },
    "%@ dials through %@, which is not another node of this profile.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 的前置代理 %2$@ 不是此配置中的其他节点。"
          }
        }
      }
    },
    "%@ failed validation. Replace it in Profiles before connecting.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未通过完整性校验。请先在“配置”页面替换后再连接。"
          }
        }
      }
    },
    "%@ has an invalid size. Replace it in Profiles before connecting.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的文件大小无效。请先在“配置”页面替换后再连接。"
          }
        }
      }
    },
    "%@ hosts · %@ URL · %@ body/header · %@ JS": {
      "extractionState": "manual",
