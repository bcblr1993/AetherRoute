    "Activate AetherRoute in Settings > Account before connecting.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在“设置”>“账户”中激活 AetherRoute，再建立连接。"
