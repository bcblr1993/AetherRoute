    "The profile operation could not be completed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法完成配置操作。"
          }
        }
      }
    },
    "The subscription contains invalid Base64 text.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅包含无效的 Base64 文本。"
          }
        }
      }
    },
    "The subscription contains more than %lld nodes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅包含超过 %lld 个节点。"
          }
        }
      }
    },
    "The subscription is neither supported YAML nor a share-link list.": {
      "localizations": {
