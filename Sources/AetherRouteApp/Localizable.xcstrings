        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法安全保存所选节点。"
          }
        }
      }
    },
    "The selected node will be used on the next connection.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选节点将在下次连接时使用。"
          }
        }
      }
    },
    "The selected profile and automatic rollback both failed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选配置与自动恢复均失败，请检查诊断信息。"
          }
        }
      }
    },
    "The selected profile could not establish a working connection.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选配置无法建立可用连接。"
          }
        }
