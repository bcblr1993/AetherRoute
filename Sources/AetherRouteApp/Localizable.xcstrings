    "Add at least one profile before creating a portable archive.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请至少添加一个配置后再创建便携档案。"
          }
        }
      }
    },
    "Address pool": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地址池"
          }
        }
      }
