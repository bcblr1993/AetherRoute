    "The service returned an invalid signed response.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务返回了无效的签名响应。"
          }
        }
      }
    },
    "The shortcut settings could not be saved.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存快捷键设置。"
          }
        }
      }
    },
    "The signed receipt reports %@. Contact support before moving this license.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "签名回执报告状态为“%@”。转移授权前请联系支持。"
          }
        }
      }
    },
    "The signed update manifest is invalid.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "签名更新清单无效。"
          }
        }
      }
    },
    "This AetherRoute link could not be opened safely.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法安全打开此 AetherRoute 链接。"
          }
        }
      }
    },
    "This unsigned UI preview cannot start Network Extensions.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此未签名界面预览版不能启动网络扩展。"
          }
        }
      }
    },
    "This Mac": {
      "localizations": {
        "zh-Hans": {
