    "Test how AetherRoute evaluates a destination across rules, Fake-IP/DNS, and proxy groups. Uses the live engine when connected and falls back to static inspection when disconnected.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
