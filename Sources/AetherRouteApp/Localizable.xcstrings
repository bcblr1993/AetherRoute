      }
    },
    "Testing latency…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在测试延迟…"
          }
        }
      }
    },
    "The activation key is sent only to your configured HTTPS license service and is never saved, logged, exported, or included in diagnostics. Receipts stay in the Data Protection Keychain on this Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "激活码只会发送到你配置的 HTTPS 授权服务，绝不会被保存、记录、导出或写入诊断报告。签名回执保存在这台 Mac 的数据保护钥匙串中。"
          }
        }
      }
    },
    "The active profile contains no ordered rule entries. Its effective fallback is determined only after the protocol core validates and starts the profile.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前配置没有有序规则。协议核心验证并启动配置后，才能确定实际的兜底行为。"
          }
        }
      }
    },
    "The active profile has no DNS section. The core therefore uses the system resolver behavior available to the selected network engine.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前配置没有 DNS 设置，因此核心会使用所选网络引擎可用的系统解析行为。"
          }
        }
      }
    },
    "The active profile is not a subscription.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前配置不是订阅配置。"
          }
        }
      }
    },
    "The active profile passed import checks but does not expose inline endpoints, groups, or providers.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前配置已通过导入检查，但没有提供内联节点、策略组或提供方。"
          }
        }
      }
    },
    "The address is stored inside the encrypted profile. Downloads are size-limited and validated before activation.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅地址会保存在加密配置中。下载内容经过大小限制和安全验证后才会启用。"
          }
        }
      }
    },
    "The archive password is too long.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "档案密码过长。"
          }
        }
      }
    },
    "The connection could not continue. Open AetherRoute to review the recovery steps.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接无法继续。请打开 AetherRoute 查看恢复步骤。"
          }
        }
      }
    },
    "The connection is busy or not ready.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接正忙或尚未就绪。"
          }
        }
      }
    },
    "The connection start time is unavailable.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接开始时间不可用。"
          }
        }
      }
    },
    "The current build number is invalid.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前构建号无效。"
          }
        }
      }
    },
    "The current connection did not stop in time.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前连接未能及时停止。"
          }
        }
      }
    },
    "The diagnostic report could not be created.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法创建诊断报告。"
