    "Subscription downloaded into library. %lld usable nodes imported; %lld invalid nodes skipped.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscription downloaded into library. %#@usable@ imported; %#@invalid@ skipped."
          },
          "substitutions": {
            "usable": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg usable node"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg usable nodes"
                    }
                  }
                }
              }
            },
            "invalid": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg invalid node"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg invalid nodes"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅已下载并保存至配置库。已导入 %1$lld 个可用节点，跳过 %2$lld 个无效节点。"
          }
        }
      }
