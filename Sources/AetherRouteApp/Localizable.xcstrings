    "Runs a standalone local HTTP & SOCKS5 proxy on 127.0.0.1 even outside TUN mode. Optionally enable System Proxy above to route macOS apps automatically.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs a standalone local HTTP & SOCKS5 proxy on 127.0.0.1 even outside TUN mode. Optionally enable System Proxy above to route macOS apps automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使在透明代理或未连接状态下，也可在 127.0.0.1 运行独立本地 HTTP / SOCKS5 代理；勾选上方「设为 macOS 系统代理」可自动接管系统流量。"
          }
        }
      }
    },
    "Runs only when you tap Check. Never probed in the background.": {
