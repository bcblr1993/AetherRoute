        }
      }
    },
    "%@ is not available on this Mac. You can still use the other engine.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在这台 Mac 上不可用，你仍可使用另一个引擎。"
          }
