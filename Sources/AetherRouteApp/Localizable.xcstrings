    },
    "The network extension returned no proxy selection response.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络扩展没有返回代理选择结果。"
          }
        }
      }
    },
    "The network extension stopped before it could report ready. Retry once, then review the active profile.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络扩展在报告就绪前停止。请先重试一次，再检查当前配置。"
          }
        }
      }
    },
    "The network extension was installed and will be available after this Mac restarts.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络扩展已安装，将在这台 Mac 重新启动后可用。"
          }
        }
      }
    },
    "The password is incorrect or the portable archive was modified.": {
      "localizations": {
