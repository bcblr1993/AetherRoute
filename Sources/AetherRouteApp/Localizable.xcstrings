            "state": "translated",
            "value": "便携配置档案过大（%lld 字节）。"
          }
        }
      }
    },
    "The portable profile payload version %lld is not supported.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持便携配置内容版本 %lld。"
          }
        }
      }
    },
    "The profile library could not be prepared for export.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法准备要导出的配置库。"
          }
        }
      }
    },
    "The profile uses a mode that requires protocol-core validation.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前配置使用的模式需要协议核心验证。"
          }
        }
      }
    },
    "The saved license cannot authorize a connection. Review Settings > Account.": {
      "localizations": {
