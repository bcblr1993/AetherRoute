    "%@ was imported and verified.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已导入并通过校验。"
          }
        }
      }
    },
    "Download & Verify": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载并校验"
          }
        }
      }
    },
    "Downloads are user-initiated over HTTPS and checksum-verified. Country.mmdb is MaxMind-derived through Loyalsoldier; GeoSite.dat is provided by V2Fly. Their upstream licenses apply.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载仅由用户主动发起，使用 HTTPS 并校验哈希。Country.mmdb 由 Loyalsoldier 基于 MaxMind 数据提供；GeoSite.dat 由 V2Fly 提供，并分别适用其上游许可。"
          }
        }
      }
    },
    "Checking…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查…"
          }
