            "value": "此 Mac"
          }
        }
      }
    },
    "This page is a privacy-safe view of the imported profile. The protocol core remains authoritative and validates DNS semantics when a session starts.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
