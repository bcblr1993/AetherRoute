            "value": "%@（已回退）"
          }
        }
      }
    },
    "%@ (not in this profile)": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（不在此配置中）"
