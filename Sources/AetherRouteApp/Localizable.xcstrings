{
  "sourceLanguage": "en",
  "strings": {
    "%.0f ms": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%.0f 毫秒"
          }
        }
      }
    },
    "%1$@ is not answering, so %2$@ is in use. Traffic returns to %1$@ once it answers again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首选节点“%1$@”暂无响应，正在使用“%2$@”。“%1$@”恢复后会自动切回。"
          }
        }
      }
    },
    "%1$@ stopped answering, so %2$@ took over at %3$@. Traffic returns to %1$@ once it answers again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首选节点“%1$@”无响应，已于 %3$@ 切换到“%2$@”。“%1$@”恢复后会自动切回。"
          }
        }
      }
    },
    "%@ (%lld): %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$lld 个）：%3$@"
          }
        }
      }
    },
    "%@ (Estimated)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（估算）"
          }
        }
      }
    },
    "%@ (Fallback)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (Fallback)"
