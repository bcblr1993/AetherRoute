    "The network extension installation is already in progress.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络扩展正在安装，请稍候。"
          }
        }
      }
    },
    "The network extension rejected an invalid latency request.": {
      "localizations": {
