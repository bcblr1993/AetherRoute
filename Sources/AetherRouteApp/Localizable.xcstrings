        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法完成配置操作。"
          }
        }
      }
    },
    "The profile uses a mode that requires protocol-core validation.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前配置使用的模式需要协议核心验证。"
          }
        }
      }
    },
    "The routing databases included with this app could not be verified. Reinstall AetherRoute and try again.": {
      "localizations": {
        "zh-Hans": {
