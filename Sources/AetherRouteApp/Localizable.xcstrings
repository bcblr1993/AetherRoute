    "Connect with an active profile to start a session. No connection data is fabricated while the secure connection is stopped.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用已启用的配置连接后即可开始会话。安全连接停止时不会生成虚假的连接数据。"
          }
