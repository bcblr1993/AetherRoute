            "state": "translated",
            "value": "下载的更新过大（%lld 字节）。"
          }
        }
      }
    },
    "The distribution product identifier is invalid.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分发产品标识符无效。"
          }
        }
      }
    },
    "The distribution response is too large (%lld bytes).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分发响应过大（%lld 字节）。"
          }
        }
      }
    },
    "The distribution service attempted an unexpected redirect.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分发服务尝试了未允许的重定向。"
