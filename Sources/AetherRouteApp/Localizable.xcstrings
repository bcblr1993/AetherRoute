    },
    "The selected profile failed. The previous profile was restored.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选配置连接失败，已自动恢复原配置。"
          }
        }
      }
    },
    "The selected route answered the latency and data-plane checks.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected route answered the latency and data-plane checks."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选线路已通过延迟与数据面检查。"
          }
