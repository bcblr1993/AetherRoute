            "state": "translated",
            "value": "全部"
          }
        }
      }
    },
    "All Systems Operational": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全链路通畅"
          }
        }
      }
    },
    "All counts %lld active flows; Proxied, Direct, and Rejected reflect the top %lld captured flows.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All counts %#@active@; Proxied, Direct, and Rejected reflect the top %#@captured@."
          },
          "substitutions": {
            "active": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg active flow"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg active flows"
                    }
                  }
                }
              }
            },
            "captured": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg captured flow"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg captured flows"
                    }
                  }
                }
              }
            }
          }
        },
