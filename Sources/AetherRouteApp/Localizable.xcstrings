        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共 %lld 个"
          }
        }
      }
    },
    "A DNS section is present, but its resolver is disabled.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前配置包含 DNS 设置，但解析器已关闭。"
          }
