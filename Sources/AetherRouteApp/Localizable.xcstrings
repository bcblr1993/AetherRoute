    "The license does not match this product or Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该授权与此产品或这台 Mac 不匹配。"
          }
        }
      }
    },
    "The license has expired.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授权已过期。"
          }
        }
      }
    },
    "The local licensing identity is invalid.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机授权标识无效。"
          }
        }
      }
    },
    "Another network extension request is already pending. Wait a moment, then try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有另一个网络扩展请求正在等待处理。请稍候再试。"
          }
        }
      }
    },
    "Move AetherRoute to the Applications folder, reopen it, and try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请将 AetherRoute 移到“应用程序”文件夹，重新打开后再试。"
          }
        }
      }
    },
    "Network extension installation was canceled. Retry when you are ready.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络扩展安装已取消。准备好后请重试。"
          }
        }
      }
    },
    "This AetherRoute package is incomplete. Download a fresh official copy and try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 AetherRoute 安装包不完整。请重新下载官方版本后再试。"
          }
        }
      }
    },
    "This build does not have the required Network Extension permission. Install the signed official release.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此构建缺少所需的网络扩展权限。请安装已签名的官方版本。"
          }
        }
      }
    },
    "This copy of AetherRoute is damaged or incorrectly signed. Download a fresh official copy and try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 AetherRoute 副本已损坏或签名不正确。请重新下载官方版本后再试。"
          }
        }
      }
    },
    "macOS or your organization blocked this network extension. Review Network Extensions in System Settings or contact your administrator.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 或您的组织阻止了此网络扩展。请在系统设置中检查“网络扩展”，或联系管理员。"
          }
        }
      }
    },
    "The network extension could not be installed. Retry once, then open Diagnostics if the problem continues.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法安装网络扩展。请先重试一次；若问题仍存在，请打开“诊断”。"
          }
        }
      }
    },
    "The network extension cannot report connected until the audited protocol bridge has started and passed readiness checks.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有经过审计的协议桥接启动并通过就绪检查后，网络扩展才会显示已连接。"
          }
        }
      }
    },
    "The network extension did not answer the proxy selection request in time.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络扩展未及时响应代理选择请求。"
          }
        }
      }
    },
    "The network extension installation is already in progress.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络扩展正在安装中。"
          }
