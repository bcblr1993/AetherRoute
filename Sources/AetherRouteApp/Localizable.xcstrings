            "value": "安全连接无法启动。请检查配置后重试。"
          }
        }
      }
    },
    "The selected file is not a valid AetherRoute portable archive.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选文件不是有效的 AetherRoute 便携档案。"
          }
        }
      }
    },
    "The selected key is read into memory, never displayed, and saved only in the encrypted profile library.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选私钥仅载入内存且不会明文显示，只保存在加密配置库中。"
          }
        }
      }
    },
    "The selected node could not be saved securely.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法安全保存所选节点。"
          }
        }
