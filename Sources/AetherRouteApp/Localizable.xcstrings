          }
        }
      }
    },
    "macOS System Proxy is pointing to 127.0.0.1:%@ / :%@.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS System Proxy is pointing to 127.0.0.1:%@ / :%@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已接管 macOS 系统代理（127.0.0.1:%@ / :%@）。"
          }
        }
      }
    },
    "macOS asks whether AetherRoute may add proxy and VPN configurations. Choose Allow for each.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 会询问是否允许 AetherRoute 添加代理与 VPN 配置，每次都请选择“允许”。"
          }
        }
      }
    },
    "macOS finishes installing the extension after a restart. Open AetherRoute again afterwards to continue.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 需要重启后才能完成扩展安装。重启后再次打开 AetherRoute 即可继续。"
          }
        }
      }
    },
    "macOS may ask for an administrator password to remove the extensions. Profiles synced through iCloud stay in iCloud.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除扩展时 macOS 可能会要求输入管理员密码。通过 iCloud 同步的配置会保留在 iCloud 中。"
          }
        }
      }
    },
    "macOS opens Login Items & Extensions. Under Network Extensions, switch on both AetherRoute entries. You may need your password or Touch ID.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 会打开“登录项与扩展”。在“网络扩展”中打开两个 AetherRoute 开关，可能需要输入密码或使用触控 ID。"
          }
        }
      }
    },
    "macOS or your organization blocked this network extension. Review Network Extensions in System Settings or contact your administrator.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 或你的组织阻止了此网络扩展。请在“系统设置”中查看“网络扩展”，或联系管理员。"
