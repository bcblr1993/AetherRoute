{
  "sourceLanguage": "en",
  "strings": {
    "Accelerate domestic network & Apple services": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加速国内网络与 Apple 服务"
          }
        }
      }
    },
    "Injects high-speed direct routing and domestic DNS policy for Apple CDN, updates, and domestic websites.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为 Apple CDN、系统更新及国内主流网站注入高速直连分流规则与国内 DNS 解析策略。"
          }
        }
      }
    },
    "Startup": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动"
          }
        }
      }
    },
    "Launch at login": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开机自启动"
          }
        }
      }
    },
    "Automatically start AetherRoute when logging into macOS. If connected before quitting, it will automatically reconnect upon launch.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在登录 macOS 时自动启动 AetherRoute。若退出或关机前处于连接状态，启动后将自动恢复连接。"
          }
        }
      }
    },
    "AetherRoute requires approval in System Settings > General > Login Items & Extensions.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AetherRoute 需要在「系统设置 > 通用 > 登录项与扩展」中予以允许。"
          }
        }
      }
    },
    "Dock & Menu Bar": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock 与菜单栏"
          }
        }
      }
    },
    "Hide Dock icon": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏 Dock 图标"
          }
        }
      }
    },
    "Keep AetherRoute in the menu bar only without a Dock icon. The main window can be reopened from the menu bar or by clicking the app icon.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后 AetherRoute 仅在菜单栏常驻，不占用 Dock 栏。可通过菜单栏或重新点击应用图标唤起主面板。"
          }
        }
      }
    },
    "Add a subscription link or import a Clash-compatible configuration to get started.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加 HTTPS 订阅链接或导入 Clash 兼容的配置文件即可开始使用。"
          }
        }
      }
    },
    "Clash Compatible": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "兼容 Clash"
          }
        }
      }
    },
    "Import HTTPS subscription URL from your provider.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从服务商获取并导入 HTTPS 订阅链接。"
          }
        }
      }
    },
    "Multi-Protocol": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多协议支持"
          }
        }
      }
    },
    "No Profiles Added": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未添加任何配置"
          }
        }
      }
    },
    "Supports Clash-compatible YAML/JSON profiles.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持 Clash 兼容的 YAML/JSON 配置文件。"
          }
        }
      }
    },
    "%@ · %lld members": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %lld 个成员"
          }
        }
      }
    },
    "%@ · Manual": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · 手动"
          }
        }
      }
    },
    "%@ failed validation. Replace it in Profiles before connecting.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未通过完整性校验。请先在“配置”页面替换后再连接。"
          }
        }
      }
    },
    "%@ has an invalid size. Replace it in Profiles before connecting.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的文件大小无效。请先在“配置”页面替换后再连接。"
          }
        }
      }
    },
    "%@ is already used by another app": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已被其他应用占用"
          }
        }
      }
    },
    "%@ is more than 30 days old. Update it in Profiles before connecting.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已超过 30 天未更新。请先在“配置”页面更新后再连接。"
          }
        }
      }
    },
    "%@ is required by this profile. Add it in Profiles before connecting.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前配置需要 %@。请先在“配置”页面添加后再连接。"
          }
        }
      }
    },
    "%@ must be a whole non-negative number.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 必须是非负整数。"
          }
        }
      }
    },
    "%@ was imported and verified.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已导入并通过校验。"
          }
        }
      }
    },
    "%lld components": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld component"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld components"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个组件"
          }
        }
      }
    },
    "%lld group": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 组"
          }
        }
      }
    },
    "%lld groups": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 组"
          }
        }
      }
    },
    "%lld ms": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 毫秒"
          }
        }
      }
    },
    "%lld native nodes · encrypted on this Mac": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld native node · encrypted on this Mac"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld native nodes · encrypted on this Mac"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个原生节点 · 已在此 Mac 上加密"
          }
        }
      }
    },
    "%lld profiles are available after secure import.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld profile is available after secure import."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld profiles are available after secure import."
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安全导入后共有 %lld 个配置可用。"
          }
        }
      }
    },
    "%lld rules": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld rule"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld rules"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 条规则"
          }
        }
      }
    },
    "%lld total": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共 %lld 个"
          }
        }
      }
    },
    "%lld total · %lld recognized · %lld pending core check · %lld unsupported": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共 %1$lld 个 · %2$lld 个已识别 · %3$lld 个待核心检查 · %4$lld 个不支持"
          }
        }
      }
    },
    "A DNS section is present, but its resolver is disabled.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前配置包含 DNS 设置，但解析器已关闭。"
          }
        }
      }
    },
    "A native profile must keep at least one node.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原生配置必须至少保留一个节点。"
          }
        }
      }
    },
    "A profile encryption key could not be created. Quit and reopen AetherRoute, then try again. If the problem continues, export diagnostics.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法创建配置加密密钥。请退出并重新打开 AetherRoute 后重试；若仍失败，请导出诊断。"
          }
        }
      }
    },
    "AAAA responses are allowed by this profile.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前配置允许返回 AAAA 响应。"
          }
        }
      }
    },
    "AAAA responses are filtered by this profile.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前配置会过滤 AAAA 响应。"
          }
        }
      }
    },
    "About": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        }
      }
    },
    "About AetherRoute": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于 AetherRoute"
          }
        }
      }
    },
    "Account": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户"
          }
        }
      }
    },
    "Activate": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "激活"
          }
        }
      }
    },
    "active": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有效"
          }
        }
      }
    },
    "Active": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行中"
          }
        }
      }
    },
    "Active connections": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "活动连接"
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加"
          }
        }
      }
    },
    "Add at least one profile before creating a portable archive.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请至少添加一个配置后再创建便携档案。"
          }
        }
      }
    },
    "Add Node": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加节点"
          }
        }
      }
    },
    "Add Node…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加节点…"
          }
        }
      }
    },
    "Add Profile Subscription": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加配置订阅"
          }
        }
      }
    },
    "Add Subscription…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加订阅…"
          }
        }
      }
    },
    "Additional SOCKS5-only port": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Additional SOCKS5-only port"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "额外的纯 SOCKS5 端口"
          }
        }
      }
    },
    "Address": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地址"
          }
        }
      }
    },
    "Address pool": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地址池"
          }
        }
      }
    },
    "Advanced": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高级选项"
          }
        }
      }
    },
    "AetherRoute": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AetherRoute"
          }
        }
      }
    },
    "AetherRoute %@ is available": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AetherRoute %@ 可以下载"
          }
        }
      }
    },
    "AetherRoute application content": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AetherRoute 应用内容"
          }
        }
      }
    },
    "AetherRoute binds only 127.0.0.1 and never changes the macOS system proxy. Shell commands affect only the terminal where you paste them.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AetherRoute 仅绑定 127.0.0.1，绝不会更改 macOS 系统代理。终端命令只影响粘贴它的终端会话。"
          }
        }
      }
    },
    "AetherRoute could not access its shared storage. Quit and reopen the app, then try again. If the problem continues, export diagnostics.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法访问 AetherRoute 的共享存储。请退出并重新打开应用后重试；若仍失败，请导出诊断。"
          }
        }
      }
    },
    "AetherRoute could not access the profile encryption key in Keychain. Quit and reopen the app, then try again. If the problem continues, export diagnostics.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法访问钥匙串中的配置加密密钥。请退出并重新打开 AetherRoute 后重试；若仍失败，请导出诊断。"
          }
        }
      }
    },
    "AetherRoute could not confirm a healthy connection. Retry once, then review the active profile.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AetherRoute 无法确认连接健康。请先重试一次，再检查当前配置。"
          }
        }
      }
    },
    "AetherRoute disconnected": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AetherRoute 已断开"
          }
        }
      }
    },
    "AetherRoute does not sell network data, build advertising profiles, or include behavioral trackers.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AetherRoute 不会出售网络数据，不会建立广告画像，也不包含行为跟踪器。"
          }
        }
      }
    },
    "AetherRoute has not downloaded or changed anything yet.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AetherRoute 尚未下载或更改任何内容。"
          }
        }
      }
    },
    "AetherRoute is free to use. Import your own proxy configuration to get started.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AetherRoute 可免费使用，导入你自己的代理配置即可开始。"
          }
        }
      }
    },
    "AetherRoute is preparing the local extension configuration.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AetherRoute 正在准备本机网络扩展配置。"
          }
        }
      }
    },
    "AetherRoute needs attention": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AetherRoute 需要处理"
          }
        }
      }
    },
    "AetherRoute prepares routing rules automatically when you connect.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接时由 AetherRoute 自动准备，无需手动操作。"
          }
        }
      }
    },
    "AetherRoute processes proxy profiles, network destinations, addresses, and routing decisions locally on this Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AetherRoute 会在此 Mac 本地处理代理配置、网络目标、地址和路由决策。"
          }
        }
      }
    },
    "AetherRoute settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AetherRoute 设置"
          }
        }
      }
    },
    "AetherRoute verifies signed license receipts and update manifests without storing your activation key.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AetherRoute 会验证签名授权回执和更新清单，但不会保存你的激活码。"
          }
        }
      }
    },
    "AetherRoute will not access this address until you confirm.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认之前，AetherRoute 不会访问这个地址。"
          }
        }
      }
    },
    "AetherRoute will not create or save a network extension configuration, import or download a profile, or connect until you agree.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你同意前，AetherRoute 不会创建或保存网络扩展配置、导入或下载配置，也不会连接。"
          }
        }
      }
    },
    "AetherRoute's Keychain access configuration is invalid. Reinstall AetherRoute and try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AetherRoute 的钥匙串访问配置无效。请重新安装 AetherRoute 后重试。"
          }
        }
      }
    },
    "All": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部"
          }
        }
      }
    },
    "All engines · IPv4 route": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部引擎 · IPv4 路由"
          }
        }
      }
    },
    "All engines · IPv6 route": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部引擎 · IPv6 路由"
          }
        }
      }
    },
    "All supported traffic follows the selected routing mode.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有受支持流量都遵循当前路由模式。"
          }
        }
      }
    },
    "Allowed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许"
          }
        }
      }
    },
    "Allowed IPs": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许的 IP 段"
          }
        }
      }
    },
    "Alter ID: %lld": {
      "localizations": {
        "zh-Hans": {
