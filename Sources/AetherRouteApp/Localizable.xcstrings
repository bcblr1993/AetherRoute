      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已被其他应用占用"
          }
        }
      }
    },
    "%@ · %lld members": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %lld 个成员"
          }
        }
      }
    },
    "%lld components": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个组件"
          }
        }
