        }
      }
    },
    "The selected profile could not establish a working connection.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选配置无法建立可用连接。"
          }
        }
      }
    },
    "The selected profile failed. The previous profile was restored.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选配置连接失败，已自动恢复原配置。"
          }
        }
      }
    },
    "The selected profile no longer exists.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选配置文件已不存在。"
          }
        }
      }
    },
    "The selected route answered the latency and data-plane checks.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected route answered the latency and data-plane checks."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选线路已通过延迟与数据面检查。"
          }
        }
      }
    },
    "The selected routing mode could not be saved to the network extension configuration.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法将所选路由模式保存到网络扩展配置。"
          }
        }
      }
    },
    "The selected rule provider could not be found.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到所选规则集。"
          }
        }
      }
    },
    "The service response signature could not be verified.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证服务响应的签名。"
          }
        }
      }
    },
    "The service returned an invalid signed response.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务返回了无效的签名响应。"
          }
        }
      }
    },
    "The shared App Group container is unavailable.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享 App Group 容器不可用。"
          }
        }
      }
    },
    "The shortcut settings could not be saved.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存快捷键设置。"
          }
        }
      }
    },
    "The signed receipt reports %@. Contact support before moving this license.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "签名回执报告状态为“%@”。转移授权前请联系支持。"
          }
        }
      }
    },
    "The signed update manifest is invalid.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "签名更新清单无效。"
          }
        }
      }
    },
    "The subscription contains invalid Base64 text.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅包含无效的 Base64 文本。"
          }
        }
      }
    },
    "The subscription contains more than %lld nodes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅包含超过 %lld 个节点。"
          }
        }
      }
    },
    "The subscription is neither supported YAML nor a share-link list.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅既不是受支持的 YAML，也不是节点分享链接列表。"
          }
        }
      }
    },
    "The subscription provider attempted an unsafe redirect.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅提供方尝试了不安全的重定向。"
          }
        }
      }
    },
    "The subscription provider redirected too many times.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅提供方重定向次数过多。"
          }
        }
      }
    },
    "The subscription provider returned HTTP %lld. Check that the link is active and permitted for this Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅提供方返回 HTTP %lld。请检查链接是否有效，以及是否允许这台 Mac 使用。"
          }
        }
      }
    },
    "The subscription provider returned an invalid response.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅提供方返回了无效响应。"
          }
        }
      }
    },
    "The subscription reported no changes before an active profile existed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未建立当前配置时，订阅却报告没有更新。"
          }
        }
      }
    },
    "The subscription response is too large (%lld bytes).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅响应过大（%lld 字节）。"
          }
        }
      }
    },
    "The subscription uses the unsupported ‘%@’ share-link scheme.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅使用了不受支持的“%@”分享链接协议。"
          }
        }
      }
    },
    "The subscription will be downloaded and safely added to your profile library without interrupting your connection.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅将被下载并安全添加到配置库中，不会中断当前连接。"
          }
        }
      }
    },
    "The system did not report which app opened this connection.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统没有报告是哪个应用发起了这条连接。"
          }
        }
      }
    },
    "The tunnel is connected. AetherRoute is checking the selected route in the background.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tunnel is connected. AetherRoute is checking the selected route in the background."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隧道已连接。AetherRoute 正在后台检查当前线路。"
          }
        }
      }
    },
    "The tunnel remains active while AetherRoute retries the fastest available node.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隧道保持启用，AetherRoute 正在重试当前最快的可用节点。"
          }
        }
      }
    },
    "The tunnel remains active while the network recovers. You can disconnect at any time.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tunnel remains active while the network recovers. You can disconnect at any time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隧道保持启用，正在等待网络恢复。你可以随时断开连接。"
          }
        }
      }
    },
    "Theme changes apply immediately and are remembered next time.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主题切换立即生效，下次启动时保留你的选择。"
          }
        }
      }
    },
    "There are no local profiles to upload.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机没有可上传的配置。"
          }
        }
      }
    },
    "These customizations were saved by a newer version of AetherRoute.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些自定义设置来自更新版本的 AetherRoute。"
          }
        }
      }
    },
    "These options adjust DNS behaviour for the TUN engine without editing your profile.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些选项用于调整 TUN 引擎的 DNS 行为，无需修改配置文件。"
          }
        }
      }
    },
    "These rules would bring the total to %lld, above the limit of %lld. Nothing was imported; remove some rules or paste fewer.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入后规则总数将达到 %1$lld 条，超过 %2$lld 条的上限。未导入任何规则，请先删除部分规则或减少粘贴数量。"
          }
        }
      }
    },
    "They forward your traffic and queries, and can see your IP address.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They forward your traffic and queries, and can see your IP address."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转发你的流量和查询，它们能看到你的 IP 地址。"
          }
        }
      }
    },
    "They have no effect with Transparent Proxy, which uses the system DNS.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用透明代理时这些设置不生效，DNS 使用系统解析。"
          }
        }
      }
    },
    "This AetherRoute link could not be opened safely.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法安全打开此 AetherRoute 链接。"
          }
        }
      }
    },
    "This AetherRoute package is incomplete. Download a fresh official copy and try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 AetherRoute 安装包不完整。请从官方渠道重新下载后再试。"
          }
        }
      }
    },
    "This Mac": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac"
          }
        }
      }
    },
    "This Mac must stay awake while sharing the proxy connection.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享代理期间 Mac 需保持唤醒，休眠或关机将中断代理。"
          }
        }
      }
    },
    "This address is in the Fake-IP pool (198.18.0.0/15), but no cached domain mapping was found yet. Run a domain lookup here or inspect active Fake-IP connections to populate the reverse lookup table.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This address is in the Fake-IP pool (198.18.0.0/15), but no cached domain mapping was found yet. Run a domain lookup here or inspect active Fake-IP connections to populate the reverse lookup table."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该地址属于 Fake-IP 地址池（198.18.0.0/15），但应用内反查缓存中暂无对应域名映射。在此执行域名解析或产生活跃 Fake-IP 连接后会自动记录映射。"
          }
        }
      }
    },
    "This app cannot be used in a rule.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个应用无法用于规则。"
          }
        }
      }
    },
    "This automation preferences version is not supported.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持此自动化偏好设置版本。"
          }
        }
      }
    },
    "This build does not have the required Network Extension permission. Install the signed official release.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本缺少所需的网络扩展权限。请安装已签名的官方发行版。"
          }
        }
      }
    },
    "This bypass rule already exists.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此绕过规则已存在。"
          }
        }
      }
    },
    "This clears all saved daily traffic records on this Mac, not just the selected period.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将清除此 Mac 上所有已保存的每日流量记录，而不仅仅是当前所选时段。"
          }
        }
      }
    },
    "This copy of AetherRoute is damaged or incorrectly signed. Download a fresh official copy and try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 AetherRoute 副本已损坏或签名无效。请从官方渠道重新下载后再试。"
          }
        }
      }
    },
    "This edition does not contact a licensing service. Every software update is verified before it is installed.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前版本无需激活许可服务。每次软件更新在安装前都会经过验证。"
          }
        }
      }
    },
    "This group automatically uses the node with the lowest latency.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个策略组会自动选用延迟最低的节点，不需要手动指定。"
          }
        }
      }
    },
    "This group chooses a node automatically based on latency and stability.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该策略组会根据延迟与稳定性自动选择可用节点。"
          }
        }
      }
    },
    "This group chooses its node automatically.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个策略组会自动选择节点。"
          }
        }
      }
    },
    "This group has no nodes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个策略组没有节点。"
          }
        }
      }
    },
    "This group has no testable nodes": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此策略组没有可测速节点"
          }
        }
      }
    },
    "This group is automatically managed by latency tests.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此策略组由延迟测速自动选择最优节点。"
          }
        }
      }
    },
    "This group spreads connections across its nodes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个策略组会把连接分散到各个节点。"
          }
        }
      }
    },
    "This group uses the first node that responds, in list order.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个策略组按顺序使用第一个可用的节点。"
          }
        }
      }
    },
    "This is a summary of the profile; bypass rules and runtime optimization can also affect traffic.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里是配置的摘要，绕过规则和运行时优化也会影响实际流量。"
          }
        }
      }
    },
    "This license reached its device limit. Review Settings > About.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此许可证已达到设备数量上限。请前往“设置 > 关于”查看。"
          }
        }
      }
    },
    "This license reached its device limit. Review Settings > License & Updates.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This license reached its device limit. Review Settings > License & Updates."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此授权已达到设备数量上限。请检查“设置”>“许可证与更新”。"
          }
        }
      }
    },
    "This overwrites the encrypted iCloud archive with this Mac’s current profiles and deletion records, replacing newer changes from other devices.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会使用此 Mac 当前的配置文件与删除记录覆盖加密的 iCloud 归档，其他设备上较新的更改将被替换。"
          }
        }
      }
    },
    "This preview can import and inspect profiles, but it cannot enable system routing.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此预览版可以导入并检查配置，但不能启用系统路由。"
          }
        }
      }
    },
    "This profile does not expose selectable proxy members.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此配置没有可选择的代理成员。"
          }
        }
      }
    },
    "This proxy group does not support manual selection.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此代理组不支持手动选择。"
          }
        }
      }
    },
    "This proxy group does not support verified latency checks.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This proxy group does not support verified latency checks."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此代理组不支持连接验证延迟测试。"
          }
        }
      }
    },
    "This releases this Mac's activation seat and removes the local license receipt. You will need to enter your license key again to connect.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将释放此 Mac 的激活席位并移除本地许可证凭证。之后需重新输入许可证密钥才能连接。"
          }
        }
      }
    },
    "This replaces or merges local profiles using the encrypted iCloud snapshot, including deletions from other devices. Unsaved local changes may be lost.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会使用加密的 iCloud 快照替换或合并本地配置，包括其他设备上的删除记录。尚未上传的本地更改可能会丢失。"
          }
        }
      }
    },
    "This weakens server identity verification.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会降低服务器身份验证的安全性。"
          }
        }
      }
    },
    "Timed out": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超时"
          }
        }
      }
    },
    "Timeout": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超时"
          }
        }
      }
    },
    "Timeout ms": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timeout ms"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超时 ms"
          }
        }
      }
