    "AetherRoute": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AetherRoute"
          }
        }
      }
    },
    "AetherRoute %@ is available": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AetherRoute %@ 可以下载"
          }
        }
      }
    },
    "AetherRoute application content": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AetherRoute 应用内容"
          }
        }
      }
    },
    "AetherRoute could not confirm a healthy connection. Retry once, then review the active profile.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AetherRoute 无法确认连接健康。请先重试一次，再检查当前配置。"
          }
        }
      }
    },
    "AetherRoute disconnected": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AetherRoute 已断开"
          }
        }
      }
    },
    "AetherRoute does not sell network data, build advertising profiles, or include behavioral trackers.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AetherRoute 不会出售网络数据，不会建立广告画像，也不包含行为跟踪器。"
          }
        }
      }
    },
    "AetherRoute has not downloaded or changed anything yet.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AetherRoute 尚未下载或更改任何内容。"
          }
        }
      }
    },
    "AetherRoute is up to date": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AetherRoute 已是最新版本"
          }
        }
      }
    },
    "AetherRoute needs attention": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AetherRoute 需要处理"
          }
        }
      }
    },
    "AetherRoute processes proxy profiles, network destinations, addresses, and routing decisions locally on this Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AetherRoute 会在此 Mac 本地处理代理配置、网络目标、地址和路由决策。"
          }
        }
      }
    },
    "AetherRoute settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AetherRoute 设置"
          }
        }
      }
    },
    "Settings navigation": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置导航"
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置"
          }
        }
      }
    },
    "AetherRoute verifies signed license receipts and update manifests without storing your activation key.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AetherRoute 会验证签名授权回执和更新清单，但不会保存你的激活码。"
          }
        }
      }
    },
    "AetherRoute will not create or save a network extension configuration, import a profile, or connect until you agree.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你同意前，AetherRoute 不会创建或保存网络扩展配置、导入配置或连接。"
          }
        }
      }
    },
    "AetherRoute will not create or save a network extension configuration, import or download a profile, or connect until you agree.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你同意前，AetherRoute 不会创建或保存网络扩展配置、导入或下载配置，也不会连接。"
          }
        }
      }
    },
    "All engines · IPv4 route": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部引擎 · IPv4 路由"
          }
        }
