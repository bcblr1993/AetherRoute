          }
        }
      }
    },
    "The routing rule update could not be restored. Recovery files were kept. Export diagnostics if retrying does not help.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分流规则更新无法恢复，已保留恢复文件。如果重试后仍有问题，请导出诊断信息。"
          }
        }
      }
    },
    "The saved network extension configuration is invalid.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的网络扩展配置无效。"
          }
        }
      }
    },
    "The saved network extension configuration needs to be checked and prepared again.": {
      "localizations": {
        "zh-Hans": {
