    "AetherRoute needs two macOS permissions for each network engine. Grant them once now, and connecting or switching engines later will never stop for a prompt.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个网络引擎都需要两项 macOS 授权。现在一次性完成，之后连接或切换引擎都不会再被弹窗打断。"
          }
        }
      }
    },
